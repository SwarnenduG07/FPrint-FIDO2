                "file_text": "\"\"\"fprintd D-Bus bridge for fingerprint verification.\"\"\"\n\nimport threading\nimport dbus\n\n\ndef verify_fingerprint(username: str, timeout: int = 30) -> bool:\n    \"\"\"\n    Verify fingerprint via fprintd D-Bus API.\n\n    Args:\n        username: System username to verify\n        timeout:  Seconds to wait for finger touch\n\n    Returns:\n        True if fingerprint matched, False otherwise\n    \"\"\"\n    result = threading.Event()\n    matched = [False]\n\n    try:\n        bus = dbus.SystemBus()\n        manager = dbus.Interface(\n            bus.get_object(\"net.reactivated.Fprint\", \"/net/reactivated/Fprint/Manager\"),\n            \"net.reactivated.Fprint.Manager\"\n        )\n        device_path = manager.GetDefaultDevice()\n        device = dbus.Interface(\n            bus.get_object(\"net.reactivated.Fprint\", device_path),\n            \"net.reactivated.Fprint.Device\"\n        )\n\n        def on_verify_status(status, done):\n            if status == \"verify-match\":\n                matched[0] = True\n            if done or status in (\"verify-match\", \"verify-no-match\",\n                                  \"verify-unknown-error\", \"verify-disconnected\"):\n                result.set()\n\n        device.connect_to_signal(\"VerifyStatus\", on_verify_status)\n        device.Claim(username)\n        device.VerifyStart(\"any\")\n\n        print(\"[FPRINT] Touch fingerprint sensor...\", flush=True)\n        result.wait(timeout=timeout)\n\n        device.VerifyStop()\n        device.Release()\n\n    except dbus.DBusException as e:\n        print(f\"[FPRINT] D-Bus error: {e}\", flush=True)\n        return False\n\n    return matched[0]\n",
